NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Open Finance via MeuPluggy. Nunca use o prefixo NEXT_PUBLIC nestas variáveis.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Aviso de entrada por e-mail (só funciona no site publicado).
# Chave do Resend (resend.com), e-mail que recebe os avisos e remetente opcional.
# NOTIFY_EMAIL_TO também identifica o dono do app: só ele recebe avisos e resumos.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
# Senha longa e aleatória que a Pluggy envia em cada aviso.
PLUGGY_WEBHOOK_SECRET=
# Endereço público do site, com https://, sem barra no fim.
APP_URL=

# Usada no cadastro de testadores, no resumo mensal (dia 1º) e nos avisos por e-mail.
# Chave "secret" do Supabase: ignora as regras de acesso, então fica só no servidor.
SUPABASE_SECRET_KEY=
# Senha longa e aleatória que a Vercel envia ao chamar o agendador.
CRON_SECRET=

# Cadastro de testadores: código que a pessoa digita em /cadastro.
# Sem ele, ninguém consegue criar conta. A conta é criada com SUPABASE_SECRET_KEY.
SIGNUP_INVITE_CODE=
